# .secrets.example — Lista canónica de variables privadas requeridas (RF-DATOS-006, R-03)
# Copiar este archivo a privado/.secrets y completar con los valores reales.
# IMPORTANTE: Los valores de ejemplo son deliberadamente sintéticos y no verosímiles
# para no activar falsos positivos en herramientas de escaneo como gitleaks (R-03).

telefono: "VALOR_SINTETICO_TELEFONO_EJEMPLO"
email: "usuario_ejemplo_no_valido_en_dominio_ficticio"
direccion: "VALOR_SINTETICO_DIRECCION_NO_REAL"
ciudad: "VALOR_SINTETICO_CIUDAD_EJEMPLO"
pais: "VALOR_SINTETICO_PAIS_EJEMPLO"
